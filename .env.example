PORT = 9999 # Required. Range: 1 to 65535. Only Integers.
# file preserves HW11; start:infisical injects infisical and ignores local .env.
CONFIG_SOURCE=file
# Required in Infisical mode. Fake contract only; actual value comes from dev/prod.
DB_URL=postgresql://app:FAKE_PASSWORD@127.0.0.1:6432/marketplace
# Infisical mode: local server, project metadata and read-only access token file.
INFISICAL_API_URL=http://localhost:8088
INFISICAL_PROJECT_ID=replace-with-project-id
INFISICAL_ENVIRONMENT=dev
INFISICAL_TOKEN_FILE=secrets/infisical/app-token
# Required in file mode, non-empty PostgreSQL host; localhost for Nest running on the host.
DB_HOST = 'localhost'
# Required in file mode, non-empty PostgreSQL role; also used by Compose to initialize the DB.
DB_USER = 'admin'
# Required in file mode, non-empty database name; also used by Compose to initialize the DB.
DB_NAME = 'admin'
# Optional; defaults to 5432 when absent. Integer in range 1–65535.
DB_PORT = 5432
# Required in file mode, non-empty secret-file path relative to the working directory (or absolute).
# Store the password in this ignored file, never as an environment variable.
DB_PASSWORD_FILE = 'secrets/db_password'
