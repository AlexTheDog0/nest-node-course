PORT = 9999 # Required. Range: 1 to 65535. Only Integers.
# Required, non-empty PostgreSQL host; localhost for Nest running on the host.
DB_HOST = 'localhost'
# Required, non-empty PostgreSQL role; also used by Compose to initialize the DB.
DB_USER = 'admin'
# Required, non-empty database name; also used by Compose to initialize the DB.
DB_NAME = 'admin'
# Optional; defaults to 5432 when absent. Integer in range 1–65535.
DB_PORT = 5432
# Required, non-empty secret-file path relative to the working directory (or absolute).
# Store the password in this ignored file, never as an environment variable.
DB_PASSWORD_FILE = 'secrets/db_password'
